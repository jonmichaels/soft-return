<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Root cause of Quick Look failing on Jon's dev-g console: a dev build is re-signed
	     WITHOUT entitlements, and a sandboxed appex with none at all refuses to load. This is
	     the minimum an appex needs to load at all. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- No file-access entitlement beyond app-sandbox: `PreviewProvider.providePreview(for:)`
	     reads `request.fileURL`, a URL the system (not the user, not an NSOpenPanel) hands the
	     extension over XPC for exactly this one call — Quick Look attaches a temporary sandbox
	     read grant for that URL automatically. `user-selected` entitlements cover files a
	     person picked inside THIS app; that never happens here. -->

	<!-- Job 178 (b8): this extension's sandbox has no /usr/bin/mdimport (proven on the b7
	     console — see SoftReturn.entitlements' doc comment), so it can no longer spawn its
	     own index request. This grants it the shared group container to enqueue into instead
	     — see SpotlightIndexQueue. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>RC448RH3EN.softreturn</string>
	</array>
</dict>
</plist>
