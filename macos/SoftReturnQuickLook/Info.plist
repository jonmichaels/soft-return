<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<!-- Batch 40 (M11): a VIEW-based preview. The principal class is an NSViewController
		     conforming to QLPreviewingController (preparePreviewOfFile(at:completionHandler:)),
		     which shows page 1 as soon as it is made and appends the rest. A data-based
		     QLPreviewProvider has to return one finished PDF, so nothing showed until every page
		     was made (-HOLYMAC.WS: 5.3 s). QLIsDataBasedPreview is gone: it declares the
		     data-based API, and set false with a QLPreviewProvider principal class it asserted in
		     QLPreviewExtensionViewController.m:139 (2026-08-08) — that failure was the wrong
		     KIND of principal class for a view-based preview, which this is not. -->
		<key>NSExtensionPrincipalClass</key>
		<string>SoftReturnQuickLook.PreviewViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- Our exported UTI ONLY. Jon ruled 2026-08-08: no hijacking .txt previews —
				     claiming public.plain-text would put our preview on every .txt on the Mac. -->
				<string>me.beforeti.wordstar-document</string>
				<!-- Job 374 (QL-PIX): standalone `.PIX` images, same extension point,
				     dispatched content-first inside PreviewViewController itself. -->
				<string>me.beforeti.wordstar-pix</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
	</dict>
</dict>
</plist>
